# 老脚本产出用 *_dom.html，新脚本（make_livepush 等）用 dom_ 前缀，两种都要排掉
# 注意：.gitignore 不支持行尾注释，# 必须独占一行，否则整行会被当成 pattern
_dev/dom_*.html
_dev/*.png
_dev/pg*/
_dev/pc*/
_dev/u[0-9]*
_dev/rs[0-9]*
_dev/rg_*
_dev/R_*
_dev/pon
_dev/pf*
_dev/pp*
_dev/uf*
_dev/_chk*.js
_dev/*_dom.html
_dev/*_rg.html
_dev/*_R.html

